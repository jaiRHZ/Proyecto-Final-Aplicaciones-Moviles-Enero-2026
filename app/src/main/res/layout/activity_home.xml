<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <!-- ── Toolbar Personalizada ── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarHome"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/happybox_primary"
        app:contentInsetStart="16dp"
        app:contentInsetEnd="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleHome"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:id="@+id/ivCart"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_cart"
                    app:tint="@color/white"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/white"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── Buscador Estilizado ── -->
            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="@color/happybox_secondary"
                android:hint="@string/hintBuscar"
                android:textColorHint="#9E9E9E"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:drawableTint="#9E9E9E"
                android:inputType="text"
                android:layout_marginBottom="24dp"
                android:elevation="0dp"/>

            <!-- ── Título Categorías ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titleCategorias"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <!-- ── Barra de Chips de Categorías ── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <!-- Chip: Detalles -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/cardDetalles"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catDetalles"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/happybox_primary"
                        app:chipStrokeWidth="0dp"
                        app:chipIcon="@android:drawable/btn_star_big_on"
                        app:chipIconTint="@color/white"
                        app:chipIconVisible="true"
                        android:checkable="false"
                        android:layout_margin="4dp"/>

                    <!-- Chip: Globos -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/cardGlobos"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catGlobos"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/happybox_primary"
                        app:chipStrokeWidth="0dp"
                        app:chipIcon="@android:drawable/ic_menu_send"
                        app:chipIconTint="@color/white"
                        app:chipIconVisible="true"
                        android:checkable="false"
                        android:layout_margin="4dp"/>

                    <!-- Chip: Peluches -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/cardPeluches"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catPeluches"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/happybox_primary"
                        app:chipStrokeWidth="0dp"
                        app:chipIcon="@android:drawable/btn_star_big_off"
                        app:chipIconTint="@color/white"
                        app:chipIconVisible="true"
                        android:checkable="false"
                        android:layout_margin="4dp"/>

                    <!-- Chip: Regalos -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/cardRegalos"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catRegalos"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/happybox_primary"
                        app:chipStrokeWidth="0dp"
                        app:chipIcon="@android:drawable/ic_menu_view"
                        app:chipIconTint="@color/white"
                        app:chipIconVisible="true"
                        android:checkable="false"
                        android:layout_margin="4dp"/>

                    <!-- Chip: Tazas -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/cardTazas"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/catTazas"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/happybox_primary"
                        app:chipStrokeWidth="0dp"
                        app:chipIcon="@android:drawable/ic_menu_compass"
                        app:chipIconTint="@color/white"
                        app:chipIconVisible="true"
                        android:checkable="false"
                        android:layout_margin="4dp"/>

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Navigation ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/nav_selector"
        app:itemTextColor="@color/nav_selector"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        android:elevation="16dp"/>

</LinearLayout>