<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_producto">

    <!-- Imagen del producto -->
    <ImageView
        android:id="@+id/imgCarritoProducto"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_imagen_producto"
        android:padding="6dp"
        android:contentDescription="@null"/>

    <!-- Columna central: nombre, precio unitario, subtotal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvCarritoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Nombre del producto"/>

        <!-- Precio unitario en gris -->
        <TextView
            android:id="@+id/tvCarritoPrecioUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:text="$0.00 c/u"/>

        <!-- Subtotal de esta línea en rosa -->
        <TextView
            android:id="@+id/tvCarritoSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/Widget.HappyBox.PriceText"
            android:textSize="13sp"
            android:text="$0.00"/>

    </LinearLayout>

    <!-- Columna derecha: controles de cantidad y eliminar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="8dp">

        <!-- Botón eliminar (ícono basura) -->
        <ImageButton
            android:id="@+id/btnCarritoEliminar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/text_hint"
            android:background="@null"
            android:contentDescription="@string/btnEliminar"
            android:layout_gravity="end"
            android:layout_marginBottom="6dp"/>

        <!-- Fila +/cantidad/- -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnCarritoMenos"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="−"
                android:textColor="@color/white"
                style="@style/Widget.HappyBox.QtyButton"/>

            <TextView
                android:id="@+id/tvCarritoCantidad"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="1"/>

            <Button
                android:id="@+id/btnCarritoMas"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="+"
                android:textColor="@color/white"
                style="@style/Widget.HappyBox.QtyButton"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>