<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <!-- ── Toolbar ── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarProductos"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_background"
        app:titleTextColor="@color/toolbar_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/titleProductos"
        style="@style/Widget.HappyBox.Toolbar"/>

    <!-- ── Chips de filtro (horizontal, con scroll si son muchos) ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.HappyBox.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chipTodos"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrecioAsc"
                style="@style/Widget.HappyBox.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chipPrecioAsc"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrecioDesc"
                style="@style/Widget.HappyBox.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chipPrecioDesc"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNombre"
                style="@style/Widget.HappyBox.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chipNombre"/>

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- ── ListView de productos (ocupa el espacio disponible) ── -->
    <ListView
        android:id="@+id/listViewProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"/>

    <!-- ── Bottom Navigation ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavProductos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_card"
        app:itemIconTint="@color/nav_selector"
        app:itemTextColor="@color/nav_selector"
        app:menu="@menu/bottom_nav_menu"
        style="@style/Widget.HappyBox.BottomNavigation"/>

</LinearLayout>