<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <!-- ── Toolbar ── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCarrito"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_background"
        app:titleTextColor="@color/toolbar_title"
        app:title="@string/titleCarrito"
        style="@style/Widget.HappyBox.Toolbar"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- Lista de productos en carrito (Placeholder) -->
        <ListView
            android:id="@+id/listViewCarrito"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:layout_above="@+id/layoutResumen"/>

        <!-- Texto si el carrito está vacío -->
        <TextView
            android:id="@+id/tvCarritoVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toastCarritoVacio"
            android:layout_centerInParent="true"
            android:visibility="gone"/>

        <!-- Resumen de compra -->
        <LinearLayout
            android:id="@+id/layoutResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:paddingTop="16dp"
            android:background="@color/background_screen">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Subtotal -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvSubtotalCarrito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="$0.00"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                </RelativeLayout>

                <!-- IVA -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IVA (16%)"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvIvaCarrito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="$0.00"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                </RelativeLayout>

                <!-- Envío -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Envío"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"/>
                        <TextView
                            android:id="@+id/tvPromoEnvio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" (¡Gratis en compras mayores a $200!)"
                            android:textSize="12sp"
                            android:textColor="@color/happybox_primary"
                            android:textStyle="bold"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvEnvioCarrito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="$0.00"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_default"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Total -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/labelTotal"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvTotalCarrito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="$0.00"
                        android:textSize="18sp"
                        android:textColor="@color/text_price"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btnConfirmarPedido"
                style="@style/Widget.HappyBox.Button.Primary"/>

        </LinearLayout>
    </RelativeLayout>

</LinearLayout>