<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base de la aplicación -->
    <style name="Theme.HappyBox" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Colores principales del tema Material -->
        <item name="colorPrimary">@color/happybox_primary</item>
        <item name="colorPrimaryVariant">@color/happybox_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/happybox_secondary</item>
        <item name="colorSecondaryVariant">@color/happybox_secondary_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Fondo general de pantallas -->
        <item name="android:windowBackground">@color/background_screen</item>
        <item name="android:colorBackground">@color/background_screen</item>

        <!-- Colores de texto globales -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Estilo de la Toolbar -->
        <item name="toolbarStyle">@style/Widget.HappyBox.Toolbar</item>

        <!-- Sin ActionBar nativa (usamos Toolbar en cada layout) -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ─────────────────────────────────────────
         Toolbar
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/toolbar_background</item>
        <item name="titleTextColor">@color/toolbar_title</item>
        <item name="subtitleTextColor">@color/toolbar_title</item>
    </style>

    <!-- ─────────────────────────────────────────
         Botón primario (fondo rosa, texto blanco)
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">@color/happybox_primary_dark</item>
    </style>

    <!-- ─────────────────────────────────────────
         Botón outline (borde rosa, texto rosa)
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/btn_outline_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/btn_outline_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/background_screen</item>
        <item name="rippleColor">@color/happybox_secondary</item>
    </style>

    <!-- ─────────────────────────────────────────
         Campo de texto (EditText)
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/border_input</item>
        <item name="boxStrokeWidth">0.5dp</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxBackgroundColor">@color/background_input</item>
    </style>

    <!-- ─────────────────────────────────────────
         Chip de filtro (activo e inactivo)
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_inactive_background</item>
        <item name="android:textColor">@color/chip_inactive_text</item>
        <item name="chipStrokeWidth">0.5dp</item>
        <item name="chipStrokeColor">@color/border_default</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.HappyBox.Chip.Active" parent="Widget.HappyBox.Chip">
        <item name="chipBackgroundColor">@color/chip_active_background</item>
        <item name="android:textColor">@color/chip_active_text</item>
        <item name="chipStrokeColor">@color/chip_active_background</item>
    </style>

    <!-- ─────────────────────────────────────────
         Badge "Disponible"
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.Badge" parent="android:Widget.TextView">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/badge_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- ─────────────────────────────────────────
         Texto de precio
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.PriceText" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_price</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ─────────────────────────────────────────
         Bottom Navigation
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/nav_selector</item>
        <item name="itemTextColor">@color/nav_selector</item>
        <item name="android:background">@color/background_card</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ─────────────────────────────────────────
         Tema para activity sin ActionBar nativa
         (úsalo en el AndroidManifest por activity)
    ───────────────────────────────────────── -->
    <style name="Theme.HappyBox.NoActionBar" parent="Theme.HappyBox">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ─────────────────────────────────────────
         Botón de cantidad (+/-) en el carrito
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.QtyButton" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_qty_button</item>
        <item name="android:textColor">@color/qty_btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ─────────────────────────────────────────
         Sección de resumen/total en el carrito
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.ResumenCarrito" parent="android:Widget">
        <item name="android:background">@drawable/bg_resumen_carrito</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- ─────────────────────────────────────────
         Texto de label del resumen (gris)
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.ResumenLabel" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_total_label</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- ─────────────────────────────────────────
         Texto del monto total (rosa, grande)
    ───────────────────────────────────────── -->
    <style name="Widget.HappyBox.TotalAmount" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_total_amount</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>